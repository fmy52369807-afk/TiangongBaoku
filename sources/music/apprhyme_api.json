{
  "name": "AppRhyme 音乐API",
  "version": "1.0",
  "description": "从 custom_api.evc 提取的音乐源 API 配置。AppRhyme 是一个音乐聚合应用，支持酷我音乐和网易云音乐的播放信息获取。",
  "source": {
    "type": "evc",
    "originalFile": "legacy/apprhyme_custom_api.evc",
    "cdnUrl": "https://cdn.jsdelivr.net/gh/hhhackor/AppRhymeApi@main/custom_api.evc",
    "platform": "AppRhyme (Dart/Flutter)",
    "encodedFormat": "EVC (Encoded Value Container)",
    "libraries": [
      "dart:core",
      "dart:async",
      "dart:io",
      "dart:collection",
      "dart:convert",
      "dart:math",
      "dart:typed_data",
      "package:http_helper/helper.dart",
      "package:crypto_helper/crypto.dart",
      "package:api/main.dart"
    ]
  },
  "apis": {
    "kuwo": {
      "name": "酷我音乐",
      "function": "_getKuWoPlayInfo",
      "description": "获取酷我音乐的播放链接，支持多音质选择",
      "method": "GET",
      "baseUrl": "https://mobi.kuwo.cn/mobi.s",
      "queryParams": {
        "f": "web",
        "prod": "kwplayer_ar_10.3.3.0",
        "type": "convert_url",
        "rid": "{music_rid}",
        "br": "{quality}"
      },
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
        "sec-ch-ua": "\"Chromium\";v=\"124\", \"Google Chrome\";v=\"124\", \"Not-A.Brand\";v=\"99\""
      },
      "responseMapping": {
        "url": "url",
        "bitrate": "bitrate",
        "format": "format",
        "size": "size"
      },
      "qualityLevels": {
        "min": 56,
        "max": 69
      }
    },
    "wangyi": {
      "name": "网易云音乐",
      "function": "_getWangYiPlayInfo",
      "description": "获取网易云音乐的播放链接，支持音质级别选择",
      "method": "GET",
      "baseUrl": "https://csm.sayqz.com/api/rhyme/",
      "queryParams": {
        "id": "{music_id}",
        "level": "{quality_level}"
      },
      "responseMapping": {
        "url": "url",
        "level": "level",
        "bitrate": "bitrate",
        "format": "format",
        "size": "size"
      },
      "errorResponse": {
        "code": "code",
        "msg": "msg",
        "data": "data"
      }
    },
    "unified": {
      "name": "统一音乐接口",
      "function": "getMusicPlayInfo",
      "description": "根据 source 参数自动路由到酷我或网易云",
      "params": {
        "source": "kuwo|wangyi",
        "id": "音乐资源ID",
        "quality": "音质参数"
      }
    }
  },
  "supportedFeatures": {
    "rc4Decrypt": true,
    "base64Decode": true,
    "jsonParse": true,
    "qualitySelection": true,
    "multiSource": true
  },
  "formatTypes": {
    "kuwo": ["mp3", "flac", "wav"],
    "wangyi": ["mp3", "flac"]
  }
}
